{
  "name": "secure-vm-desktop",
  "productName": "Anchi",
  "version": "0.1.1",
  "private": true,
  "description": "Local agent desktop control plane",
  "main": "src/main/app.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs && npm run format:check && npm test",
    "format": "prettier --write src scripts tests package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests package.json .prettierrc.json",
    "package": "npm run check && node scripts/package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.3",
    "prettier": "3.9.8"
  }
}
