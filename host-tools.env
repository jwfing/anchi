# Host-side tools Anchi downloads for itself when the computer lacks them. Kept apart from
# guest/cell.env, whose bytes are part of the prebuilt image compatibility digest.
# The daemon parses this file (anchi/packages/daemon/src/host-tools.ts); scripts/package-release.sh ships it.
ANCHI_LIMA_VERSION=2.2.0
ANCHI_LIMA_SHA256_DARWIN_ARM64=bbdef91774885a0d05f7b048c4eb89ae2bcf3a0c252ae7ca7934e63df76d93c3
ANCHI_LIMA_SHA256_LINUX_X64=a0ea1ccf6b7335a900adb5f8d2b8384457965fecb1ba72f09b4e3e46d12f424a
# The Codex CLI the daemon runs as `codex app-server` to sign in to ChatGPT without a terminal
# (anchi/packages/daemon/src/codex-sign-in.ts). Same version as the cells' ANCHI_CODEX_VERSION.
ANCHI_HOST_CODEX_VERSION=0.160.1
ANCHI_HOST_CODEX_SHA256_DARWIN_ARM64=670af2b049d9c95afb74d7da385f30c5033d13a07175001dd8958c51944984d0
ANCHI_HOST_CODEX_SHA256_LINUX_X64=9226581be592d18f7e7f740a352fdb63aa61e45e39f7eb9b09d3888c84bba33f
