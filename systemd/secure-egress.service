[Unit]
Description=Install fail-closed per-service network rules
Wants=network-online.target
After=network-online.target
Before=secure-auth.service secure-gmail.service secure-inference.service secure-policy.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/bin/python3 /opt/secure-vm/services/network_rules.py init

[Install]
WantedBy=multi-user.target
